[Desktop Entry]
Version=1.0
Type=Application
Name=Ascolto
Comment=Open Ascolto settings and manage conversations
Exec=/home/voloirex/ascolto-linux/scripts/launch_ascolto.sh app
Path=/home/voloirex/ascolto-linux
Icon=/home/voloirex/ascolto-linux/assets/ascolto-icon.svg
Terminal=false
Categories=AudioVideo;Audio;
StartupNotify=false
Actions=StartNow;StopNow;PauseResume;OpenTranscripts;QuitDaemon;

[Desktop Action StartNow]
Name=Start recording
Exec=/home/voloirex/ascolto-linux/scripts/launch_ascolto.sh start

[Desktop Action StopNow]
Name=Stop recording
Exec=/home/voloirex/ascolto-linux/scripts/launch_ascolto.sh stop

[Desktop Action PauseResume]
Name=Pause or resume
Exec=/home/voloirex/ascolto-linux/scripts/launch_ascolto.sh pause

[Desktop Action OpenTranscripts]
Name=Open transcripts folder
Exec=/home/voloirex/ascolto-linux/scripts/launch_ascolto.sh open-folder

[Desktop Action QuitDaemon]
Name=Quit Ascolto
Exec=/home/voloirex/ascolto-linux/scripts/launch_ascolto.sh quit
